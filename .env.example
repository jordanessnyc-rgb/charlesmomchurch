# ---- Site -------------------------------------------------------------------
# Public URL of the site (used for SEO, sitemap, Stripe redirects, email links).
NEXT_PUBLIC_SITE_URL=https://www.casademilagros.org

# ---- Database (Postgres: Supabase, Neon, Railway, Vercel Postgres...) ---------
# Optional. Without it the site renders the built-in default content and form
# submissions are only emailed (not stored). The admin dashboard needs it.
DATABASE_URL=

# ---- Admin dashboard ---------------------------------------------------------
# Password for /admin and a long random secret used to sign the login cookie.
# Generate the secret with: openssl rand -hex 32
ADMIN_PASSWORD=
AUTH_SECRET=

# ---- Email (any SMTP provider: Resend, Google Workspace, Titan, SendGrid...) --
# Used for team notifications and automatic confirmation emails for every form.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "From" address shown to recipients, e.g. "Casa de Milagros <no-reply@casademilagros.org>"
EMAIL_FROM=
# Fallback inbox for form notifications when the per-form addresses in
# Admin → Settings are empty.
EMAIL_TEAM=

# ---- Donations (Stripe) ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Spam protection (Cloudflare Turnstile, optional) ------------------------
# When both are set, every public form shows a Turnstile widget and the server
# verifies the token. Without them the forms still use a honeypot + timing check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Analytics (optional) ----------------------------------------------------
# Vercel Analytics is on automatically when deployed to Vercel.
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Google Maps (optional) --------------------------------------------------
# Without a key the Plan Your Visit page uses the keyless Google Maps embed.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# ---- Photo uploads from the admin dashboard (optional) -----------------------
# Vercel Blob read/write token. Without it, paste image URLs instead.
BLOB_READ_WRITE_TOKEN=
